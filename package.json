{
	"name": "autodater",
	"version": "2.3.0",
	"description": "Automatically adds Created/Updated dates to YAML frontmatter.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"lint:obsidian": "eslint --config eslint.obsidian.scan.mjs .",
		"test": "node --test *.test.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian-plugin",
		"obsidian",
		"yaml",
		"frontmatter",
		"created",
		"updated",
		"timestamp"
	],
	"author": "Stanley Cheung",
	"license": "GPL-3.0",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.6.2",
		"@typescript-eslint/eslint-plugin": "^8.59.2",
		"@typescript-eslint/parser": "^8.59.2",
		"esbuild": "^0.28.0",
		"eslint": "^10.3.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"obsidian": "^1.13.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2"
	}
}
